generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
Relaciones

User N ---- M Role
User 1 ---- 1 Doctor
User 1 ---- 1 Staff
Doctor N ---- 1 Specialty
Patient 1 ---- M Appointment
Doctor 1 ---- M Appointment

*/

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor?
  staff  Staff?
  roles UserRole[]
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@unique([userId, roleId])
}

model Doctor {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String


  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  specialtyId Int
  specialty   Specialty @relation(fields: [specialtyId], references: [id])

  appointment Appointment[]
}

model Patient {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  dni         String   @unique
  dateOfBirth DateTime
  address     String?
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  status    String // e.g., 'scheduled', 'completed', 'canceled'  (pendiente, confirmado, atendido, ausente, cancelado)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
}

model Specialty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]
}

model Staff {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}
